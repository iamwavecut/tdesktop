diff --git a/external/cmark_gfm/CMakeLists.txt b/external/cmark_gfm/CMakeLists.txt
index 20dfca8..cff1b19 100644
--- a/external/cmark_gfm/CMakeLists.txt
+++ b/external/cmark_gfm/CMakeLists.txt
@@ -54,28 +54,50 @@ block()
     # install(EXPORT) rules, while tdesktop only embeds its targets.
     set(CMAKE_SKIP_INSTALL_RULES TRUE)
 
-    # tdesktop configures with --warn-uninitialized -Werror=dev, which
-    # turns cmark-gfm's perfectly-fine reads of optional variables
-    # (LIB_SUFFIX, CMAKE_REQUIRED_*, CMAKE_LINKER_FLAGS_*, ...) into
-    # hard configure errors. Suppress dev errors and warnings only
-    # within this block so the rest of tdesktop keeps its strict
-    # configure.
-    set(CMAKE_SUPPRESS_DEVELOPER_ERRORS TRUE)
-    set(CMAKE_SUPPRESS_DEVELOPER_WARNINGS TRUE)
-    if (DEFINED CACHE{CMAKE_ERROR_DEPRECATED})
-        set(_cmark_gfm_error_deprecated "${CMAKE_ERROR_DEPRECATED}")
-        set(_cmark_gfm_has_error_deprecated TRUE)
-    else()
-        set(_cmark_gfm_has_error_deprecated FALSE)
-    endif()
-    if (DEFINED CACHE{CMAKE_WARN_DEPRECATED})
-        set(_cmark_gfm_warn_deprecated "${CMAKE_WARN_DEPRECATED}")
-        set(_cmark_gfm_has_warn_deprecated TRUE)
+    # tdesktop configures with --warn-uninitialized -Werror=dev
+    # -Werror=deprecated, which turns cmark-gfm's perfectly-fine reads of
+    # optional variables (LIB_SUFFIX, CMAKE_REQUIRED_*, CMAKE_LINKER_FLAGS_*,
+    # ...) and its own deprecation messages into hard configure errors.
+    # Suppress those diagnostics only within this block so the rest of
+    # tdesktop keeps its strict configure.
+    if (POLICY CMP0218)
+        # CMake 4.4 ignores CMAKE_WARN_DEPRECATED / CMAKE_ERROR_DEPRECATED
+        # (CMP0218) and drives every diagnostic through cmake_diagnostic()
+        # instead, so even reading those two is a CMP0218 author warning --
+        # an error under -Werror=dev. CMP0218 also has to be NEW for
+        # CMD_DEPRECATED to govern the deprecation messages that predate
+        # CMake 4.4, and it goes through CMAKE_POLICY_DEFAULT_ as well so it
+        # survives cmark-gfm's cmake_minimum_required(), which unsets every
+        # policy newer than its own floor.
+        cmake_policy(SET CMP0218 NEW)
+        set(CMAKE_POLICY_DEFAULT_CMP0218 NEW)
+
+        # CMD_AUTHOR is the ancestor of CMD_DEPRECATED and CMD_POLICY, hence
+        # RECURSE; CMD_UNINITIALIZED is a root category and needs its own
+        # SET. block() scopes diagnostics the same way it scopes variables,
+        # so both are dropped again at endblock().
+        cmake_diagnostic(SET CMD_AUTHOR IGNORE RECURSE)
+        cmake_diagnostic(SET CMD_UNINITIALIZED IGNORE)
     else()
-        set(_cmark_gfm_has_warn_deprecated FALSE)
+        set(CMAKE_SUPPRESS_DEVELOPER_ERRORS TRUE)
+        set(CMAKE_SUPPRESS_DEVELOPER_WARNINGS TRUE)
+        # Unlike everything else in this block these two are cache entries,
+        # so they outlive it -- save and restore them around the subproject.
+        if (DEFINED CACHE{CMAKE_ERROR_DEPRECATED})
+            set(_cmark_gfm_error_deprecated "${CMAKE_ERROR_DEPRECATED}")
+            set(_cmark_gfm_has_error_deprecated TRUE)
+        else()
+            set(_cmark_gfm_has_error_deprecated FALSE)
+        endif()
+        if (DEFINED CACHE{CMAKE_WARN_DEPRECATED})
+            set(_cmark_gfm_warn_deprecated "${CMAKE_WARN_DEPRECATED}")
+            set(_cmark_gfm_has_warn_deprecated TRUE)
+        else()
+            set(_cmark_gfm_has_warn_deprecated FALSE)
+        endif()
+        set(CMAKE_ERROR_DEPRECATED FALSE CACHE BOOL "" FORCE)
+        set(CMAKE_WARN_DEPRECATED FALSE CACHE BOOL "" FORCE)
     endif()
-    set(CMAKE_ERROR_DEPRECATED FALSE CACHE BOOL "" FORCE)
-    set(CMAKE_WARN_DEPRECATED FALSE CACHE BOOL "" FORCE)
 
     # Defensive initialisation for the specific variables cmark-gfm
     # reads without checking. Empty strings are benign for cmark-gfm's
@@ -91,15 +113,17 @@ block()
     set(LIB_SUFFIX "")                  # src/CMakeLists.txt:155 + extensions/CMakeLists.txt:69,82
 
     add_subdirectory(${third_party_loc}/cmark-gfm cmark-gfm-build EXCLUDE_FROM_ALL)
-    if (_cmark_gfm_has_error_deprecated)
-        set(CMAKE_ERROR_DEPRECATED "${_cmark_gfm_error_deprecated}" CACHE BOOL "" FORCE)
-    else()
-        unset(CMAKE_ERROR_DEPRECATED CACHE)
-    endif()
-    if (_cmark_gfm_has_warn_deprecated)
-        set(CMAKE_WARN_DEPRECATED "${_cmark_gfm_warn_deprecated}" CACHE BOOL "" FORCE)
-    else()
-        unset(CMAKE_WARN_DEPRECATED CACHE)
+    if (NOT POLICY CMP0218)
+        if (_cmark_gfm_has_error_deprecated)
+            set(CMAKE_ERROR_DEPRECATED "${_cmark_gfm_error_deprecated}" CACHE BOOL "" FORCE)
+        else()
+            unset(CMAKE_ERROR_DEPRECATED CACHE)
+        endif()
+        if (_cmark_gfm_has_warn_deprecated)
+            set(CMAKE_WARN_DEPRECATED "${_cmark_gfm_warn_deprecated}" CACHE BOOL "" FORCE)
+        else()
+            unset(CMAKE_WARN_DEPRECATED CACHE)
+        endif()
     endif()
 endblock()
 
